{
  "name": "swarmproof",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized smart-contract auditing platform powered by a swarm of AI agents, anchored on Hedera.",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "dev:api": "pnpm --filter @swarmproof/api dev",
    "dev:web": "pnpm --filter @swarmproof/web dev",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}