# ── SwarmProof Environment Configuration ────────────────────────────────
# Copy this file to .env and customize as needed. NEVER commit .env.
# Local runs work with ZERO config — mock payments, mock HCS, and AST heuristics
# are used automatically when live credentials below are absent.

# ── 1. Server & Endpoints ────────────────────────────────────────────────
PORT=3001
SWARMPROOF_API_URL=http://localhost:3001
SWARMPROOF_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: restrict API CORS to your web origin (default *).
# SWARMPROOF_WEB_ORIGIN=http://localhost:3000

# ── 2. Payment (x402 + Blocky402 Facilitator) ───────────────────────────
# Payment network shown in the payment requirement (also the x402 hint).
PAYMENT_NETWORK=hedera:testnet
X402_NETWORK=hedera:testnet

# Blocky402 facilitator (x402 v2 wire format).
#   hosted testnet  : https://api.testnet.blocky402.com   (open, no key)
#   x402 Foundation : https://x402.org/facilitator        (open testnet)
#   mainnet (soon)  : https://api.blocky402.com/v1        (X-Api-Key)
# Leave EMPTY → offline mock facilitator (perfect for local dev/CI).
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_API_TOKEN=

# tinybars per 1 USD for the x402 quote (100,000,000 tinybars = 1 HBAR).
X402_TINYBARS_PER_USD=100000000
# Settled asset: "0.0.0" = HBAR (default). Set an HTS token id for token rails.
X402_ASSET=0.0.0

# ── 3. Client / Consumer Payer Account (Hedera Testnet) ──────────────────
# The wallet that pays for audit bounties and task pool escrows.
# Get 100 free testnet HBAR at: https://portal.hedera.com/dashboard
# Falls back to HEDERA_ACCOUNT_ID / HEDERA_PRIVATE_KEY if left unset.
X402_PAYER_ACCOUNT_ID=
X402_PAYER_PRIVATE_KEY=

# Defaults for the single job payment shown to the client before signing.
SWARMPROOF_DEFAULT_TOTAL=1.00
SWARMPROOF_CURRENCY=USD

# Gateway + verification-agent payout addresses (Hedera account IDs or EVM hex).
SWARMPROOF_GATEWAY_ADDRESS=0.0.10417474
SWARMPROOF_VERIFICATION_ADDRESS=0.0.10417474

# ── 4. Hedera Consensus Service (HCS) Proof Anchoring ───────────────────
# When configured, the API anchors cryptographic report proofs, payment trails,
# and HCS-14 agent identities on the real Hedera testnet Topic.
# Otherwise in-memory mocks are used (safe for local dev/CI).
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=0.0.10417469

# ── 5. Specialist Agent Payment Addresses (Optional Overrides) ───────────
# Override payout addresses for specific AI specialist agents (JSON map):
# SWARMPROOF_AGENT_ADDRESSES={"reentrancy-agent":"0.0.10520075","invariant-agent":"0.0.10520083"}

# ── 6. Real AI LLM Specialist Reasoning ──────────────────────────────────
# When configured, all specialist agents analyze smart contracts using real LLMs
# in parallel, cross-examining each other in weighted quorum consensus.
# If left unset, the agents safely fall back to deterministic AST heuristics.

# Option 1: Groq / DeepSeek / OpenRouter (OpenAI-compatible)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=qwen/qwen3.8-27b

# Option 2: Fireworks AI (DeepSeek / Llama 3)
# FIREWORKS_API_KEY=fw_...
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# Option 3: OpenAI (GPT-4o / GPT-4o-mini)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Option 4: Anthropic Claude (Claude 3.5 Sonnet)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 5: Local Ollama (100% Free, Private & Offline on Mac)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=deepseek-coder-v2

# ── 7. The Graph (Historical Exploit & Subgraph Queries) ─────────────────
# API key from The Graph Studio (https://thegraph.com/studio)
GRAPH_API_KEY=

# ── 8. Supabase (Audit Report & Verification State Persistence) ──────────
# Project URL & service/anon keys from Supabase dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 9. Privy (Embedded Wallets, B2B Accounts & Web3 Auth) ─────────────────
# App credentials from Privy Console (https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=