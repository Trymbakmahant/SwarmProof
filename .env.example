# ── SwarmProof environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.
# Local runs work with ZERO config — mock payment + mock HCS are used when
# the real credentials below are absent.

# ── Server ─────────────────────────────────────────────────────────────
PORT=3001
SWARMPROOF_API_URL=http://localhost:3001

# ── Payment (x402) ─────────────────────────────────────────────────────
# Payment network shown in the payment requirement (also x402 hint).
PAYMENT_NETWORK=hedera:testnet
X402_NETWORK=hedera:testnet
X402_FACILITATOR_URL=
X402_API_TOKEN=

# Defaults for the single job payment shown to the client BEFORE signing.
SWARMPROOF_DEFAULT_TOTAL=1.00
SWARMPROOF_CURRENCY=USD
# Gateway + verification-agent payout addresses (EVM or Hedera account ids).
SWARMPROOF_GATEWAY_ADDRESS=0x6666666666666666666666666666666666666666
SWARMPROOF_VERIFICATION_ADDRESS=0x7777777777777777777777777777777777777777

# ── Hedera Consensus Service (HCS) proof anchoring ─────────────────────
# When all three are set, the API uses the real Hedera client (testnet).
# Otherwise it uses an in-memory mock (perfect for local dev / CI).
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=

# ── Specialist agent payment addresses (override built-in defaults) ────
# Format: comma-free, one per line is not supported — use JSON:
# SWARMPROOF_AGENT_ADDRESSES={"reentrancy-agent":"0x...","static-agent":"0x..."}