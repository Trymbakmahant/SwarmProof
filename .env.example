# ── SwarmProof environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.
# Local runs work with ZERO config — mock payment + mock HCS are used when
# the real credentials below are absent.

# ── Server ─────────────────────────────────────────────────────────────
PORT=3001
SWARMPROOF_API_URL=http://localhost:3001

# ── Payment (x402 + Blocky402 facilitator) ─────────────────────────────
# Payment network shown in the payment requirement (also the x402 hint).
PAYMENT_NETWORK=hedera:testnet
X402_NETWORK=hedera:testnet

# Blocky402 facilitator (x402 v2 wire format).
#   hosted testnet  : https://api.testnet.blocky402.com   (open, no key)
#   x402 Foundation : https://x402.org/facilitator        (open testnet)
#   mainnet (soon)  : https://api.blocky402.com/v1        (X-Api-Key)
# Leave EMPTY → offline mock facilitator (perfect for local dev/CI).
X402_FACILITATOR_URL=
X402_API_TOKEN=

# tinybars per 1 USD for the x402 quote (default 1000000 ≈ 0.01 HBAR).
X402_TINYBARS_PER_USD=1000000
# Settled asset: "0.0.0" = HBAR (default). Set an HTS token id for token rails.
X402_ASSET=0.0.0

# ── Payment Lab: consumer-agent wallet ─────────────────────────────────
# The "wallet" that PAYS for audits in the /x402 demo page. Falls back to
# HEDERA_ACCOUNT_ID / HEDERA_PRIVATE_KEY when not set (one funded testnet
# account can demo the whole flow). Never sent to the browser — used only
# server-side to sign + settle through the facilitator.
X402_PAYER_ACCOUNT_ID=
X402_PAYER_PRIVATE_KEY=
# Optional: restrict API CORS to your web origin (default *).
# SWARMPROOF_WEB_ORIGIN=http://localhost:3000

# Defaults for the single job payment shown to the client BEFORE signing.
SWARMPROOF_DEFAULT_TOTAL=1.00
SWARMPROOF_CURRENCY=USD
# Gateway + verification-agent payout addresses (EVM or Hedera account ids).
SWARMPROOF_GATEWAY_ADDRESS=0x6666666666666666666666666666666666666666
SWARMPROOF_VERIFICATION_ADDRESS=0x7777777777777777777777777777777777777777

# ── Hedera Consensus Service (HCS) anchoring ───────────────────────────
# When all three are set, the API anchors audit proofs, payment trails and
# HCS-14 agent identities on the real Hedera testnet. Otherwise it uses
# in-memory mocks (perfect for local dev / CI).
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=

# ── Specialist agent payment addresses (override built-in defaults) ────
# Format: comma-free, one per line is not supported — use JSON:
# SWARMPROOF_AGENT_ADDRESSES={"reentrancy-agent":"0x...","static-agent":"0x..."}