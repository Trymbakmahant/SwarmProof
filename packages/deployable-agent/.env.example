# ── SwarmProof Deployable Agent Environment Configuration ───────────────
# Copy this file to .env before starting the agent worker node.

# ── 1. SwarmProof API Gateway ────────────────────────────────────────────
# The central API where this agent registers on-chain and queries tasks.
# Local: http://localhost:3001 | Production: https://swarm-proof-api.vercel.app
SWARMPROOF_API_URL=https://swarm-proof-api.vercel.app

# ── 2. Agent Identity & Role ─────────────────────────────────────────────
# Role options: reentrancy | access-control | static | all
AGENT_ID=my-sovereign-sentinel-01
AGENT_NAME=Sovereign Reentrancy Sentinel
AGENT_ROLE=reentrancy

# ── 3. A2A JSON-RPC 2.0 Server Endpoint ──────────────────────────────────
PORT=8200
# The public HTTPS or HTTP endpoint where SwarmProof dispatches A2A jobs.
# On localhost: http://localhost:8200/a2a
# On Railway / Render: https://your-app.railway.app/a2a
A2A_ENDPOINT=http://localhost:8200/a2a

# ── 4. Dedicated Hedera Testnet Wallet (Optional) ─────────────────────────
# If left unset, the agent will automatically generate a brand-new ED25519
# keypair and create a Hedera testnet account on startup.
# AGENT_ACCOUNT_ID=0.0.10119346
# AGENT_PRIVATE_KEY=3030...
